#!/bin/bash
# 双击本文件即可重新构建「编辑部工具箱」。
# 编辑部的同事不需要懂命令行——在访达里双击它就行。
cd "$(dirname "$0")" || exit 1

echo "════════════════════════════════════════════"
echo "  正在构建「编辑部工具箱」，请稍候…"
echo "════════════════════════════════════════════"
echo

./build.sh
STATUS=$?

echo
if [ $STATUS -eq 0 ]; then
  echo "✅ 构建成功，正在打开…"
  echo
  echo "  如果系统提示「无法打开，因为它来自身份不明的开发者」，"
  echo "  请在 app 上按右键 →「打开」→ 再点「打开」。只需做一次。"
  echo
  open "dist/编辑部工具箱.app"
else
  echo "❌ 构建失败。请把上面的报错信息发给技术人员。"
fi
echo
echo "（本窗口可以关闭）"
