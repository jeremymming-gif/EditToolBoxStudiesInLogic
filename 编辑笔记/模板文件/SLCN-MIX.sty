\usepackage[firstinits=true,maxcitenames=3,maxbibnames=99,backend = biber, style=caspervector,utf8, sorting=nyt]{biblatex}
% 20261028Wenming_Zhang: 参考文献页码范围印一字线 \cndash（与《排校手册》一致；\bibrangedash 须在 \DefineBibliographyExtras 里改写）。
\DefineBibliographyExtras{english}{%
	\renewcommand*{\bibrangedash}{\cndash}%
}
\renewcommand{\bibfont}{\normalfont\small}					%字体大小
\defbibenvironment{bibliography}						%修改行距
{\list
	{\printfield[labelnumberwidth]{labelnumber}}
	{\setlength{\labelwidth}{\labelnumberwidth}%
		\setlength{\leftmargin}{\labelwidth}%
		\setlength{\labelsep}{\biblabelsep}%
		\addtolength{\leftmargin}{\labelsep}%
		\setlength{\itemsep}{0.8mm}%						%此处修改行距
		\setlength{\parsep}{\bibparsep}}%
	\renewcommand*{\makelabel}[1]{\hss##1}}
{\endlist}
{\item}

\DefineBibliographyStrings{english}{%
	bibliography = {参考文献}, % = \bibname				
	references = {参考文献}, % = \refname
}
%-------------------------------------------------------------------------%
%    针对中英混排处理
%-------------------------------------------------------------------------%
\providecommand{\cegen}[2]{%定义cegen，如果userf=cn，则使用参数1，否则用参数2
	\ifthenelse%
	{\iffieldequalstr{userf}{cn}}%
	{#1}{#2}%
}%
\providecommand{\cncomma}{，}%关于中文逗号
\providecommand{\cecomma}{\cegen{\cncomma}{\addcomma\space}}%cjecomma根据userf输出逗号
\renewcommand{\newunitpunct}{\cecomma}%重新定义newunit
\providecommand{\cnperiod}{。}%关于句号
\providecommand{\ceperiod}{\cegen{\cnperiod}{\addperiod\space}}%根据userf输出句号
\renewcommand{\finentrypunct}{\ceperiod}%重新定义finentry
\providecommand{\cncolon}{：} %关于冒号
\providecommand{\cjecolon}{\cegen{\cncolon}{\addcolon\space}}%
\providecommand{\cespace}{\cegen{}{\addspace}}%
\renewcommand{\multinamedelim}{\cecomma}%
\renewcommand{\finalnamedelim}{\cegen{\cncomma}{\addspace\bibstring{and}\space}}%最后两个作者的链接，若usrf=cn则用中文逗号，否则用and
\renewcommand{\andothersdelim}{\cespace}%
\renewcommand{\postnotedelim}{\cecomma}%
\renewcommand{\bibendnotewrapper}[1]{\bibsentence #1。}%
\renewcommand{\bibfootnotewrapper}[1]{\bibsentence #1。}%
% 【2】然后再分别定义每个参数的格式（根据语言添加页/頁/p等等）
%% author 目前原理未完全弄清，建议非英文不要用and连接
%% year
\DeclareFieldFormat{year}{\cegen{{#1}年}{#1}}%
%% month
\DeclareFieldFormat{month}{\cegen{{#1}月}{#1}}%
\newbibmacro*{jp_year+month}{%
	\printfield{year}%
	\printfield{month}%
}%
%% title
\DeclareFieldFormat[article,inproceedings,incollection,misc]{title}{\cegen{“#1”}{``\MakeSentenceCase{#1}''}}%
\DeclareFieldFormat[report]{title}{\cegen{“#1”}{``\MakeSentenceCase{#1}''}}%
\DeclareFieldFormat[thesis]{title}{\it{#1}}%
\DeclareFieldFormat[book]{title}{\cegen{\mkbibemph{#1}}{\mkbibemph{#1}}}%
%% journaltitle
%% 似乎使用的时候只需要输入journal，但这里必须写journaltitle，才是默认参数，原因未知。
\DeclareFieldFormat{journaltitle}{\cegen{\mkbibemph{#1}}{\mkbibemph{#1}}}%
%% booktitle
\DeclareFieldFormat{booktitle}{\cegen{\mkbibemph{#1}}{\mkbibemph{#1}}}%
%% editor
\renewbibmacro*{editor}{%
	\ifboolexpr{%
		test \ifuseeditor%
		and%
		not test {\ifnameundef{editor}}%
	}%
	{%
		\midsentence%
		\setunit{\cegen{\cncomma}{\addcomma\space in\addspace}}%
		\printnames{editor}%
		\cegen{（编）}{\addspace(\usebibmacro{editorstrg})}%
		\setunit{\cegen{}{\addspace}}%
		\clearname{editor}%
	}%
	{}%
}%
%% volume
\DeclareFieldFormat{volume}{\cegen{第{#1}卷}{\mkbibbold{#1}}}%
\DeclareFieldFormat[article]{volume}{\cegen{第{#1}卷}{\mkbibbold{#1}}}%
\DeclareFieldFormat[inproceedings,incollection,book]{volume}{\cegen{第{#1}卷}{\mkbibbold{Vol.\,#1}}}%
%% number
\DeclareFieldFormat{number}{\cegen{第{#1}期}{\mkbibbold{(#1)}}}%
%% volume+number
\newbibmacro*{volume+number}{%
	\cegen{%中文
		\printfield{number}%
	}{%英文
	  \iffieldundef{volume}%
		{%1无volume的情况下
			\iffieldundef{pages}{\printfield{number}}{\printfield{number}{:}}%无page的情况下取消冒号
		}%
		{%2有volume的情况下
		\iffieldundef{pages}%
		 {%2.1 无page的情况下取消冒号
		 \printfield{volume}%
			\printfield{number}}%
		{%2.2 有page的情况下添加冒号
			\printfield{volume}%
			\printfield{number}{:}}%若无number则打冒号
		}%
	}%
}%
%% pages
\DeclareFieldFormat{pages}{\cegen{第#1页}{#1}}%
\DeclareFieldFormat[inproceedings,incollection]{pages}{\cegen{第#1页}{pp. #1}}%
%% publisher
\newbibmacro*{publisher+location}{%
	\iflistundef{publisher}%
	{}%
	{\iflistundef{location}%
		{\printlist{publisher}}%
		{\printlist{location}\cjecolon\printlist{publisher}}%
	}%
}%
% 有些默认的就可以，不需要改
%% location
% \DeclareFieldFormat{location}{\cegen{#1}{#1}}
%% note
\DeclareFieldFormat*{note}{{#1}}%
%似乎不能定义其他note，只能使用自带的note，未解决。
%% url
\DeclareFieldFormat*{url}{\url{#1}}%
%% type
\DeclareFieldFormat{type}{{#1}}%
% 【3】统一使用通用参数定义文献类型的格式
%定义article格式
\DeclareBibliographyDriver{article}{%
	\ifthenelse{\iffieldequalstr{userf}{cn}}%
	{%
		\printnames{author}\setunit{\cecomma}%
		\printfield{title}\setunit*{\cecomma}%
		\printfield{journaltitle}\setunit*{\cecomma}%
		\setunit{\cecomma}%
		\printfield{year}%中文只打年份
		\usebibmacro{volume+number}%
		\setunit{\cecomma}%
		\printfield{note}%
		\setunit{\cecomma}%
		\printfield{pages}%
		\setunit{\cecomma}%
		\usebibmacro{publisher+location}%
		\setunit{\cecomma}%
		\printfield{url}%
		\finentry%
	}%
	{%
		\printnames{author}%英文
		\newunit%
		\printfield{year}%
		\newunit%
		\printfield{title}%
		\newunit%
		\printfield{journaltitle}%
		\newunit%
		\usebibmacro{volume+number}%
		\newunit%
		\printfield{pages}%
		\newunit%
		\printfield{note}%目前只有这一个备注参数可用，可能不同文章需要备注的位置不同，所以是个大问题
		\newunit%
		\printfield{url}%
		\finentry%
	}%
}%
%
%定义book格式
\DeclareBibliographyDriver{book}{% 
	\ifthenelse{\iffieldequalstr{userf}{cn}}%
	{%
		\printnames{author}\setunit{\cecomma}%
		\printfield{title}\setunit*{\cecomma}%
		\iffieldequalstr{volume}{}{}{\printfield{volume}\setunit{\cecomma}}%
		\iffieldequalstr{note}{}{}{\printfield{note}\setunit{\cecomma}}%
		\usebibmacro{publisher+location}\setunit{\cecomma}%
		\printfield{year}\setunit{\cecomma}%中文只打年份
		\iffieldequalstr{url}{}{}{\printfield{url}\setunit{\cecomma}}%
		\finentry%
	}%
	{%
		\printnames{author}%
		\newunit%
		\printfield{year}%
		\newunit%
		\printfield{title}%
		\newunit%
		\printfield{volume}%
		\newunit%
		\printfield{note}%
		\newunit%
		\usebibmacro{publisher+location}%
		\finentry%
	}%
}%
