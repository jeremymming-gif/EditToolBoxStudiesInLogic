　　　　　%若干个全角空格
　　\begin{minipage}{50em}
		\ifthenelse{\equal{\mysecondauthor}{null}}{\printoneauthors}%仅有一个作者的情况
		{%           % 
			\ifthenelse{\equal{\mythirdauthor}{null}}{\printtwoauthors}%有两个作者的情况
