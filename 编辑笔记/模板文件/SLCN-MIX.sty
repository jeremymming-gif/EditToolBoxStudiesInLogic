% 20261028Wenming_Zhang: 正式发表条目的参考文献**不印 DOI、不印网址**；
%% 未出版 / 在线资源（online、unpublished、arXiv 预印本、SEP 词条等）保留并打印网址。
%% 这里是模板兜底（作者拿本刊模板自行编译也成立）；产物 bib 由引擎 `slcn/bibnorm.py`
%% 先行清洗（`Engine/docs/RULES.md` §四.10 是权威口径）。
%% SEP 词条例外：booktitle / journal 含 "Encyclopedia of Philosophy" 时不删网址。
\AtEveryBibitem{%
	\ifboolexpr{
		test {\ifentrytype{article}} or test {\ifentrytype{book}} or
		test {\ifentrytype{incollection}} or test {\ifentrytype{inproceedings}} or
		test {\ifentrytype{inbook}} or test {\ifentrytype{proceedings}} or
		test {\ifentrytype{collection}} or test {\ifentrytype{manual}} or
		test {\ifentrytype{periodical}} or test {\ifentrytype{thesis}} or
		test {\ifentrytype{phdthesis}} or test {\ifentrytype{mastersthesis}} or
		test {\ifentrytype{report}} or test {\ifentrytype{techreport}} or
		test {\ifentrytype{booklet}} or test {\ifentrytype{conference}}
	}{%
		\IfSubStr{\thefield{booktitle}}{Encyclopedia of Philosophy}{}{%
			\IfSubStr{\thefield{journaltitle}}{Encyclopedia of Philosophy}{}{%
				\clearfield{url}\clearfield{doi}%
			}%
		}%
	}{}%
}%

% 20261028Wenming_Zhang: 在线资源（@online）保留并打印网址（此前落到 caspervector 默认驱动，网址不印）
\DeclareBibliographyDriver{online}{%
	\printnames{author}%
	\newunit%
	\printfield{year}%
	\newunit%
	\printfield{title}%
	\iffieldundef{url}{}{\newunit\printfield{url}}%
	\finentry%
}%

% 一些语法记录：
% \iffieldequalstr{year}{a}{b}{c}如果year=a，则进行b，否则进行c
% \iffieldundef{a}{b}{c}如果a被定义则执行c，否则执行b

% 用于处理特殊内容，全部手打 userf不填，注意页码用--
% 20261028Wenming_Zhang: misc 只印 author 一个字段——解析不出的复杂文献由引擎把源稿原文献逐字符放进 author（verbatim），本驱动原样排印。
\DeclareBibliographyDriver{misc}{%
	\printnames{author}%
}%
